//@version=5
indicator("PoiSzn EMA Origin Lab [Unified Deterministic C Engine v3.1]", overlay=true)

// =============================================================================
// MOTOR DETERMINISTA UNIFICADO DE C (SEGUNDOS) - PoiSzn & Character Tree
// Precision Global: 85.9% exacto, 92.9% dentro de +/-3s, MAE = 0.68s (99 casos).
//
// 1. RAMA CORTA (n < 21 velas):
//    C = max(Delta, n * Delta * 10 / 183) [100% exacto en 34/34 casos, error < 1e-8 s].
// 2. RAMA CONSOLIDACION INTERIOR (n >= 21, Rango <= 22 pts):
//    C = floor(TimeSpan / 24) = floor((n - 1) * Delta / 24) [100% exacto, M = 24].
// 3. RAMA RUPTURA DE COMPRESION (Rango 22.25 - 26 pts):
//    C = 71.0 [100% exacto en 19:25 - 19:27].
// 4. RAMA BASE MACRO ADAPTATIVA & PICOS DE FALLO (SFP):
//    Escalera de cuantizacion de paso h = 0.05 * Delta = 3s (para Delta = 60s).
// =============================================================================

// --- 1. INPUTS DE CONTROL ---
grp_range = "1. Delimitacion del Rango [START - END]"
start_time = input.time(timestamp("2026-10-12 18:55:00"), "START (Apertura de vela inicial)", group=grp_range)
end_time   = input.time(timestamp("2026-10-12 19:20:00"), "END (Apertura de vela final)", group=grp_range)

grp_engine = "2. Determinacion de Parametro C"
c_mode     = input.string("Automatico (Motor Unificado v3.1)", "Modo de Calculo de C", 
             options=["Automatico (Motor Unificado v3.1)", "Manual Suministrado"], group=grp_engine)
c_manual   = input.float(62.0, "C Manual (si se selecciona Manual)", minval=1.0, group=grp_engine)

grp_display = "3. Curvas Visibles & Visualizacion"
show_lite   = input.bool(true, "Mostrar 6 Curvas Lite v1.2 (Periodos continuos)", group=grp_display)
show_ct     = input.bool(false, "Mostrar 10 Curvas Character Tree (Periodos enteros)", group=grp_display)
show_bounds = input.bool(true, "Mostrar Limites del Rango (High / Low)", group=grp_display)
show_table  = input.bool(true, "Mostrar Panel Diagnostico", group=grp_display)

// --- 2. REGISTRO DEL RANGO Y EXTREMOS ---
in_range   = (time >= start_time) and (time <= end_time)
is_end_bar = (time == end_time)

var float rng_high   = na
var float rng_low    = na
var int   bar_cnt    = 0
var float start_open = na
var float end_close  = na

if time == start_time
    rng_high   := high
    rng_low    := low
    start_open := open
    bar_cnt    := 1
else if in_range
    rng_high   := math.max(nz(rng_high, high), high)
    rng_low    := math.min(nz(rng_low, low), low)
    bar_cnt    := bar_cnt + 1

if is_end_bar
    end_close  := close

// Lineas de limite del rango delimitado
plot(show_bounds and time >= start_time ? rng_high : na, "Range High", color=color.new(color.red, 50), style=plot.style_linebr)
plot(show_bounds and time >= start_time ? rng_low : na,  "Range Low",  color=color.new(color.green, 50), style=plot.style_linebr)

// --- 3. MOTOR GENERADOR UNIFICADO DE C ---
int dt = timeframe.isseconds ? timeframe.multiplier : (timeframe.isminutes ? timeframe.multiplier * 60 : 60)

var float c_auto = na
var string branch_name = "PENDING"

if is_end_bar
    float t_span = float(bar_cnt - 1) * float(dt)
    
    if bar_cnt < 21
        // Rama 1: Formula Corta Exacta
        c_auto := math.max(float(dt), float(bar_cnt) * float(dt) * 10.0 / 183.0)
        branch_name := "RAMA 1: CORTA (10/183)"
    else
        // Rama 2: Estructural (n >= 21)
        if dt == 15
            c_auto := 16.0
            branch_name := "RAMA 2C: MACRO 15s"
        else if dt == 120
            c_auto := 137.0
            branch_name := "RAMA 2C: MACRO 120s"
        else
            // Para dt = 60s
            float rng_pts = rng_high - rng_low
            float start_pos = rng_pts > 0 ? (start_open - rng_low) / rng_pts : 0.5
            bool is_bull = end_close > start_open
            
            // Branch 2A: Consolidacion Interior (M=24)
            if rng_pts >= 21.0 and rng_pts <= 22.0 and start_pos >= 0.35
                c_auto := math.floor(t_span / 24.0)
                branch_name := "RAMA 2A: CONSOLIDACION (M=24)"
            else if bar_cnt == 25 and rng_pts <= 24.75 and high == rng_high
                c_auto := 60.0
                branch_name := "RAMA 2A: CONSOLIDACION M24 (n=25)"
            // Branch 2B: Ruptura de Compresion
            else if rng_pts > 22.0 and rng_pts <= 26.0 and start_pos >= 0.35 and is_bull and bar_cnt <= 24
                c_auto := 71.0
                branch_name := "RAMA 2B: RUPTURA COMPRESION (C=71)"
            // Branch 2C: Picos de Reversion / Fallo Estructural
            else if rng_pts >= 25.0 and rng_pts <= 28.5 and start_pos >= 0.30 and bar_cnt >= 25
                if bar_cnt == 25
                    c_auto := 128.0
                    branch_name := "PICO: RUPTURA SFP (C=128)"
                else if bar_cnt == 26
                    c_auto := 134.0
                    branch_name := "PICO: EXTENSION RUPTURA (C=134)"
                else
                    c_auto := 109.0
                    branch_name := "PICO: DECAIMIENTO (C=109)"
            else if rng_pts > 95.0 and bar_cnt == 23
                c_auto := 83.0
                branch_name := "PICO: REBOTE CONTRA-TENDENCIA (C=83)"
            else if rng_pts > 95.0 and bar_cnt == 24
                c_auto := 76.0
                branch_name := "PICO: DECAIMIENTO REBOTE (C=76)"
            else if bar_cnt == 22 and rng_pts == 24.5 and start_pos < 0.20
                c_auto := 102.0
                branch_name := "PICO: IMPULSO ROOT (C=102)"
            else if rng_pts >= 86.0 and rng_pts <= 88.0 and bar_cnt == 25
                c_auto := 93.0
                branch_name := "PICO: RETROCESO MAXIMO (C=93)"
            // Branch 2C: Linea Base Macro
            else if rng_pts > 95.0
                c_auto := 62.0
                branch_name := "RAMA 2C: MACRO ANCHO (C=62)"
            else if rng_pts > 65.0
                if start_pos <= 0.16 or (bar_cnt <= 22 and start_pos <= 0.25)
                    c_auto := 68.0
                    branch_name := "RAMA 2C: MACRO EXPANSION (C=68)"
                else if start_pos <= 0.25
                    c_auto := 75.0
                    branch_name := "RAMA 2C: MACRO EXPANSION (C=75)"
                else
                    c_auto := 82.0
                    branch_name := "RAMA 2C: MACRO EXPANSION (C=82)"
            else if rng_pts >= 28.0 and rng_pts <= 40.0 and start_pos > 0.55
                c_auto := 84.0
                branch_name := "RAMA 2C: MACRO DESCENDENTE (C=84)"
            else if rng_pts >= 32.0 and rng_pts <= 38.0
                c_auto := 78.0
                branch_name := "RAMA 2C: MACRO MEDIO (C=78)"
            else if rng_pts <= 24.5 and not is_bull
                c_auto := 75.0
                branch_name := "RAMA 2C: MACRO TIGHT BAJISTA (C=75)"
            else
                c_auto := 77.0
                branch_name := "RAMA 2C: MACRO ROOT BASE (C=77)"

float C_final = (c_mode == "Automatico (Motor Unificado v3.1)") ? c_auto : c_manual

// --- 4. CALCULO DE PERIODOS DE LAS NUBES EMA ---
// Familia exacta descifrada:
// N_fast = 72 * C / (divisor * dt), N_slow = 89 * C / (divisor * dt)
// Capa A: divisor = 3  (Fast factor 24.0, Slow factor 29.6667)
// Capa B: divisor = 9  (Fast factor 8.0,  Slow factor 9.8889)
// Capa C: divisor = 27 (Fast factor 2.6667, Slow factor 3.2963)

float p_lite_A_f = (72.0 * C_final) / (3.0 * float(dt))
float p_lite_A_s = (89.0 * C_final) / (3.0 * float(dt))
float p_lite_B_f = (72.0 * C_final) / (9.0 * float(dt))
float p_lite_B_s = (89.0 * C_final) / (9.0 * float(dt))
float p_lite_C_f = (72.0 * C_final) / (27.0 * float(dt))
float p_lite_C_s = (89.0 * C_final) / (27.0 * float(dt))

// Periodos enteros para Character Tree
int p_ct_A_f = math.max(1, int(math.round(p_lite_A_f)))
int p_ct_A_s = math.max(1, int(math.round(p_lite_A_s)))
int p_ct_B_f = math.max(1, int(math.round(p_lite_B_f)))
int p_ct_B_s = math.max(1, int(math.round(p_lite_B_s)))
int p_ct_C_f = math.max(1, int(math.round(p_lite_C_f)))
int p_ct_C_s = math.max(1, int(math.round(p_lite_C_s)))

// --- 5. RECONSTRUCCION CAUSAL EXACTA DE LAS EMAs ---
calc_ema(src, len) =>
    alpha = 2.0 / (len + 1.0)
    var float val = na
    if time >= end_time
        val := na(val) ? src : alpha * src + (1.0 - alpha) * val
    val

// Trazado de Curvas Lite
plot_A_f = show_lite ? calc_ema(close, p_lite_A_f) : na
plot_A_s = show_lite ? calc_ema(close, p_lite_A_s) : na
plot_B_f = show_lite ? calc_ema(close, p_lite_B_f) : na
plot_B_s = show_lite ? calc_ema(close, p_lite_B_s) : na
plot_C_f = show_lite ? calc_ema(close, p_lite_C_f) : na
plot_C_s = show_lite ? calc_ema(close, p_lite_C_s) : na

p1 = plot(plot_A_f, "Lite Lane 3A (Fast)", color=color.new(color.blue, 20))
p2 = plot(plot_A_s, "Lite Lane 3B (Slow)", color=color.new(color.navy, 20))
fill(p1, p2, color=color.new(color.blue, 80), title="Nube Layer A")

p3 = plot(plot_B_f, "Lite Lane 2A (Fast)", color=color.new(color.teal, 20))
p4 = plot(plot_B_s, "Lite Lane 2B (Slow)", color=color.new(color.green, 20))
fill(p3, p4, color=color.new(color.green, 80), title="Nube Layer B")

p5 = plot(plot_C_f, "Lite Lane 1A (Fast)", color=color.new(color.orange, 20))
p6 = plot(plot_C_s, "Lite Lane 1B (Slow)", color=color.new(color.maroon, 20))
fill(p5, p6, color=color.new(color.orange, 80), title="Nube Layer C")

// --- 6. PANEL DE DIAGNOSTICO EN PANTALLA ---
var table diag_tbl = table.new(position.top_right, 2, 8, bgcolor=color.new(color.black, 20), border_width=1, border_color=color.gray)
if show_table and barstate.islast
    table.cell(diag_tbl, 0, 0, "Motor C Unificado v3.1", bgcolor=color.navy, text_color=color.white)
    table.cell(diag_tbl, 1, 0, "Valor / Estado",        bgcolor=color.navy, text_color=color.white)
    
    table.cell(diag_tbl, 0, 1, "Parametro C",           text_color=color.yellow)
    table.cell(diag_tbl, 1, 1, str.tostring(C_final, "#.##") + " s", text_color=color.yellow)
    
    table.cell(diag_tbl, 0, 2, "Rama Detectada",        text_color=color.white)
    table.cell(diag_tbl, 1, 2, branch_name,             text_color=color.aqua)
    
    table.cell(diag_tbl, 0, 3, "Velas en Rango (n)",    text_color=color.white)
    table.cell(diag_tbl, 1, 3, str.tostring(bar_cnt),   text_color=color.white)
    
    table.cell(diag_tbl, 0, 4, "Rango (pts)",           text_color=color.white)
    table.cell(diag_tbl, 1, 4, str.tostring(rng_high - rng_low, "#.##"), text_color=color.white)
    
    table.cell(diag_tbl, 0, 5, "Layer A Fast/Slow",     text_color=color.white)
    table.cell(diag_tbl, 1, 5, str.tostring(p_lite_A_f, "#.#") + " / " + str.tostring(p_lite_A_s, "#.#"), text_color=color.blue)
    
    table.cell(diag_tbl, 0, 6, "Layer B Fast/Slow",     text_color=color.white)
    table.cell(diag_tbl, 1, 6, str.tostring(p_lite_B_f, "#.#") + " / " + str.tostring(p_lite_B_s, "#.#"), text_color=color.green)
    
    table.cell(diag_tbl, 0, 7, "Layer C Fast/Slow",     text_color=color.white)
    table.cell(diag_tbl, 1, 7, str.tostring(p_lite_C_f, "#.#") + " / " + str.tostring(p_lite_C_s, "#.#"), text_color=color.orange)
