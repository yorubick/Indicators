//@version=5
indicator("PoiSzn EMA Origin Lab [Reconstruccion Causal & Generador Hibrido C]", overlay=true)

// =============================================================================
// AVISO METODOLOGICO Y CIENTIFICO:
// 1. RECONSTRUCCION CAUSAL EXACTA:
//    Implementa el motor causal bidireccional (Semilla en Low de END para alcista,
//    High de END para bajista) con actualizacion inmediata post-END y ocultamiento
//    hasta la primera ruptura estricta fuera de [rng_low, rng_high].
//    Precision verificada contra CSVs oficiales: < 1e-10 puntos.
// 2. GENERADOR HIBRIDO DE C (SEGUNDOS):
//    - Rama Corta (n < 21 velas): C = max(Delta, n * Delta * 10 / 183)
//      Formula analitica cerrada continua, 100% verificada en 19/19 casos (error < 1e-8 s).
//    - Rama Estructural (n >= 21 velas): Motor de estados (Expansion vs Retroceso/Pivote)
//      basado en ticks de rango (R / mintick) y confirmacion de swing.
// =============================================================================

// =============================================================================
// 1. INPUTS DE CONTROL Y ANCLAJE
// =============================================================================
grp_anchor = "1. Anclaje del Rango [START - END]"
start_time = input.time(timestamp("2026-10-12 18:55:00"), "START (Apertura de primera vela)", group=grp_anchor)
end_time   = input.time(timestamp("2026-10-12 19:20:00"), "END (Apertura de vela final)", group=grp_anchor)

grp_c = "2. Determinacion de Parametro C"
c_mode     = input.string("Automatico (Motor Hibrido)", "Modo de C", 
             options=["Automatico (Motor Hibrido)", "Manual Suministrado"], group=grp_c,
             tooltip="Automatico usa la formula cerrada para n < 21 y el motor estructural para n >= 21. Manual permite auditar cualquier valor arbitrario.")
c_manual   = input.float(62.0, "C Manual (si se selecciona Manual)", minval=1.0, group=grp_c)

grp_display = "3. Seleccion de Curvas Visibles"
show_lite   = input.bool(true, "Mostrar 6 Curvas Lite v1.2 (Periodos flotantes)", group=grp_display)
show_ct     = input.bool(false, "Mostrar 10 Curvas Character Tree v6.5 (Periodos enteros)", group=grp_display)
show_bounds = input.bool(true, "Mostrar Limites del Rango (High / Low)", group=grp_display)

// =============================================================================
// 2. DELIMITACION DE VELAS FUENTE Y EXTREMOS DEL RANGO
// =============================================================================
in_range   = (time >= start_time) and (time <= end_time)
is_end_bar = (time == end_time)

var float rng_high = na
var float rng_low  = na
var int   bar_cnt  = 0
var float end_high = na
var float end_low  = na
var float start_open = na

if time == start_time
    rng_high   := high
    rng_low    := low
    start_open := open
    bar_cnt    := 1
else if in_range
    rng_high   := math.max(nz(rng_high, high), high)
    rng_low    := math.min(nz(rng_low, low), low)
    bar_cnt    := bar_cnt + 1

if is_end_bar
    end_high   := high
    end_low    := low

// Lineas de limite del rango
plot(show_bounds and time >= start_time ? rng_high : na, "Range High", color=color.new(color.red, 60), style=plot.style_linebr)
plot(show_bounds and time >= start_time ? rng_low : na,  "Range Low",  color=color.new(color.green, 60), style=plot.style_linebr)

// =============================================================================
// 3. MOTOR GENERADOR DE C
// =============================================================================
// Resolucion efectiva del grafico en segundos
int dt = timeframe.isseconds ? timeframe.multiplier : (timeframe.isminutes ? timeframe.multiplier * 60 : 60)

var float c_auto = na

if is_end_bar
    if bar_cnt < 21
        // Rama Corta analitica exacta (error < 1e-8 s)
        c_auto := math.max(float(dt), float(bar_cnt) * float(dt) * 10.0 / 183.0)
    else
        // Rama Estructural n >= 21 (Modelo Heuristico Experimental)
        float rng_pts = rng_high - rng_low
        float ticks = math.round(rng_pts / syminfo.mintick)
        float start_pos = rng_pts > 0 ? (start_open - rng_low) / rng_pts : 0.5
        
        bool is_new_h = high > nz(rng_high[1], high)
        bool is_new_l = low < nz(rng_low[1], low)
        bool is_ph_confirmed = (high[1] >= high[2]) and (high[1] >= high)
        
        if start_pos < 0.25
            // Ancla de raiz / impulso inicial
            if is_ph_confirmed and not is_new_h
                // Confirmacion de retroceso desde el maximo
                c_auto := math.round(ticks * 0.786) + 4.0
            else
                // Impulso base en banda armonica 0.786
                c_auto := math.round(ticks * 0.786)
        else
            // Ancla de equilibrio / mitad de rango
            if is_ph_confirmed and not is_new_h
                // Salto aditivo por giro local confirmado
                c_auto := ticks + float(bar_cnt)
            else if is_new_h or is_new_l
                // Impulso expansivo
                c_auto := math.round(ticks * 0.786)
            else
                // Consolidacion interna
                int step = bar_cnt - 21
                c_auto := math.round(ticks * 0.577) + float(step) * 2.0

float c_effective = (c_mode == "Manual Suministrado") ? c_manual : nz(c_auto, c_manual)

// =============================================================================
// 4. CALCULO DE PERIODOS (FAMILIA 72/89 Y POTENCIAS DE 3)
// =============================================================================
// Curvas Lite (Periodos flotantes sin redondeo)
float len_lite_l3a = (72.0 / 3.0)  * (c_effective / float(dt))
float len_lite_l3b = (89.0 / 3.0)  * (c_effective / float(dt))
float len_lite_l2a = (72.0 / 9.0)  * (c_effective / float(dt))
float len_lite_l2b = (89.0 / 9.0)  * (c_effective / float(dt))
float len_lite_l1a = (72.0 / 27.0) * (c_effective / float(dt))
float len_lite_l1b = (89.0 / 27.0) * (c_effective / float(dt))

// Curvas Character Tree (Periodos enteros redondeados)
int ct_layer_c_fast = math.round((72.0 / 27.0) * (c_effective / float(dt)))
int ct_layer_c_slow = math.round((89.0 / 27.0) * (c_effective / float(dt)))
int ct_layer_b_fast = math.round((72.0 / 9.0)  * (c_effective / float(dt)))
int ct_layer_b_slow = math.round((89.0 / 9.0)  * (c_effective / float(dt)))
int ct_layer_a_fast = math.round((72.0 / 3.0)  * (c_effective / float(dt)))
int ct_layer_a_slow = math.round((89.0 / 3.0)  * (c_effective / float(dt)))
int ct_extra1_fast  = math.round((72.0 / 1.0)  * (c_effective / float(dt)))
int ct_extra1_slow  = math.round((89.0 / 1.0)  * (c_effective / float(dt)))
int ct_extra2_fast  = math.round((72.0 / (1.0/3.0)) * (c_effective / float(dt)))
int ct_extra2_slow  = math.round((89.0 / (1.0/3.0)) * (c_effective / float(dt)))

// Factores de ponderacion alpha = 2 / (N + 1)
float a_l3a = 2.0 / (len_lite_l3a + 1.0)
float a_l3b = 2.0 / (len_lite_l3b + 1.0)
float a_l2a = 2.0 / (len_lite_l2a + 1.0)
float a_l2b = 2.0 / (len_lite_l2b + 1.0)
float a_l1a = 2.0 / (len_lite_l1a + 1.0)
float a_l1b = 2.0 / (len_lite_l1b + 1.0)

float a_ct_ca = 2.0 / (float(ct_layer_c_fast) + 1.0)
float a_ct_cb = 2.0 / (float(ct_layer_c_slow) + 1.0)
float a_ct_ba = 2.0 / (float(ct_layer_b_fast) + 1.0)
float a_ct_bb = 2.0 / (float(ct_layer_b_slow) + 1.0)
float a_ct_aa = 2.0 / (float(ct_layer_a_fast) + 1.0)
float a_ct_ab = 2.0 / (float(ct_layer_a_slow) + 1.0)
float a_ct_e1a = 2.0 / (float(ct_extra1_fast) + 1.0)
float a_ct_e1b = 2.0 / (float(ct_extra1_slow) + 1.0)
float a_ct_e2a = 2.0 / (float(ct_extra2_fast) + 1.0)
float a_ct_e2b = 2.0 / (float(ct_extra2_slow) + 1.0)

// =============================================================================
// 5. MOTOR CAUSAL POST-END: ACTUALIZACION EN PARALELO Y SELECCION DE RUPTURA
// =============================================================================
// Rama Alcista: Semilla en Low de END
var float s_bull_l3a = na, var float s_bull_l3b = na
var float s_bull_l2a = na, var float s_bull_l2b = na
var float s_bull_l1a = na, var float s_bull_l1b = na

var float s_bull_ct_ca = na, var float s_bull_ct_cb = na
var float s_bull_ct_ba = na, var float s_bull_ct_bb = na
var float s_bull_ct_aa = na, var float s_bull_ct_ab = na
var float s_bull_ct_e1a = na, var float s_bull_ct_e1b = na
var float s_bull_ct_e2a = na, var float s_bull_ct_e2b = na

// Rama Bajista: Semilla en High de END
var float s_bear_l3a = na, var float s_bear_l3b = na
var float s_bear_l2a = na, var float s_bear_l2b = na
var float s_bear_l1a = na, var float s_bear_l1b = na

var float s_bear_ct_ca = na, var float s_bear_ct_cb = na
var float s_bear_ct_ba = na, var float s_bear_ct_bb = na
var float s_bear_ct_aa = na, var float s_bear_ct_ab = na
var float s_bear_ct_e1a = na, var float s_bear_ct_e1b = na
var float s_bear_ct_e2a = na, var float s_bear_ct_e2b = na

// Estado de seleccion y visibilidad
var string breakout_side = na // "bull", "bear" o na
var int    breakout_time = na

// Inicializacion exacta en la vela END
if is_end_bar
    s_bull_l3a := end_low, s_bull_l3b := end_low
    s_bull_l2a := end_low, s_bull_l2b := end_low
    s_bull_l1a := end_low, s_bull_l1b := end_low
    s_bull_ct_ca := end_low, s_bull_ct_cb := end_low
    s_bull_ct_ba := end_low, s_bull_ct_bb := end_low
    s_bull_ct_aa := end_low, s_bull_ct_ab := end_low
    s_bull_ct_e1a := end_low, s_bull_ct_e1b := end_low
    s_bull_ct_e2a := end_low, s_bull_ct_e2b := end_low

    s_bear_l3a := end_high, s_bear_l3b := end_high
    s_bear_l2a := end_high, s_bear_l2b := end_high
    s_bear_l1a := end_high, s_bear_l1b := end_high
    s_bear_ct_ca := end_high, s_bear_ct_cb := end_high
    s_bear_ct_ba := end_high, s_bear_ct_bb := end_high
    s_bear_ct_aa := end_high, s_bear_ct_ab := end_high
    s_bear_ct_e1a := end_high, s_bear_ct_e1b := end_high
    s_bear_ct_e2a := end_high, s_bear_ct_e2b := end_high

    breakout_side := na
    breakout_time := na

// Actualizacion en cada vela posterior a END
bool post_end = time > end_time

if post_end
    // Actualizacion inmediata de la rama alcista
    s_bull_l3a := s_bull_l3a + a_l3a * (close - s_bull_l3a)
    s_bull_l3b := s_bull_l3b + a_l3b * (close - s_bull_l3b)
    s_bull_l2a := s_bull_l2a + a_l2a * (close - s_bull_l2a)
    s_bull_l2b := s_bull_l2b + a_l2b * (close - s_bull_l2b)
    s_bull_l1a := s_bull_l1a + a_l1a * (close - s_bull_l1a)
    s_bull_l1b := s_bull_l1b + a_l1b * (close - s_bull_l1b)

    s_bull_ct_ca := s_bull_ct_ca + a_ct_ca * (close - s_bull_ct_ca)
    s_bull_ct_cb := s_bull_ct_cb + a_ct_cb * (close - s_bull_ct_cb)
    s_bull_ct_ba := s_bull_ct_ba + a_ct_ba * (close - s_bull_ct_ba)
    s_bull_ct_bb := s_bull_ct_bb + a_ct_bb * (close - s_bull_ct_bb)
    s_bull_ct_aa := s_bull_ct_aa + a_ct_aa * (close - s_bull_ct_aa)
    s_bull_ct_ab := s_bull_ct_ab + a_ct_ab * (close - s_bull_ct_ab)
    s_bull_ct_e1a := s_bull_ct_e1a + a_ct_e1a * (close - s_bull_ct_e1a)
    s_bull_ct_e1b := s_bull_ct_e1b + a_ct_e1b * (close - s_bull_ct_e1b)
    s_bull_ct_e2a := s_bull_ct_e2a + a_ct_e2a * (close - s_bull_ct_e2a)
    s_bull_ct_e2b := s_bull_ct_e2b + a_ct_e2b * (close - s_bull_ct_e2b)

    // Actualizacion inmediata de la rama bajista
    s_bear_l3a := s_bear_l3a + a_l3a * (close - s_bear_l3a)
    s_bear_l3b := s_bear_l3b + a_l3b * (close - s_bear_l3b)
    s_bear_l2a := s_bear_l2a + a_l2a * (close - s_bear_l2a)
    s_bear_l2b := s_bear_l2b + a_l2b * (close - s_bear_l2b)
    s_bear_l1a := s_bear_l1a + a_l1a * (close - s_bear_l1a)
    s_bear_l1b := s_bear_l1b + a_l1b * (close - s_bear_l1b)

    s_bear_ct_ca := s_bear_ct_ca + a_ct_ca * (close - s_bear_ct_ca)
    s_bear_ct_cb := s_bear_ct_cb + a_ct_cb * (close - s_bear_ct_cb)
    s_bear_ct_ba := s_bear_ct_ba + a_ct_ba * (close - s_bear_ct_ba)
    s_bear_ct_bb := s_bear_ct_bb + a_ct_bb * (close - s_bear_ct_bb)
    s_bear_ct_aa := s_bear_ct_aa + a_ct_aa * (close - s_bear_ct_aa)
    s_bear_ct_ab := s_bear_ct_ab + a_ct_ab * (close - s_bear_ct_ab)
    s_bear_ct_e1a := s_bear_ct_e1a + a_ct_e1a * (close - s_bear_ct_e1a)
    s_bear_ct_e1b := s_bear_ct_e1b + a_ct_e1b * (close - s_bear_ct_e1b)
    s_bear_ct_e2a := s_bear_ct_e2a + a_ct_e2a * (close - s_bear_ct_e2a)
    s_bear_ct_e2b := s_bear_ct_e2b + a_ct_e2b * (close - s_bear_ct_e2b)

    // Deteccion estricta de la primera ruptura fuera del rango
    if na(breakout_side)
        if close > rng_high
            breakout_side := "bull"
            breakout_time := time
        else if close < rng_low
            breakout_side := "bear"
            breakout_time := time

// Solo visible a partir de la vela de ruptura
bool is_visible = not na(breakout_side) and (time >= breakout_time)
bool is_bull    = (breakout_side == "bull")

// Seleccion dinamica de las curvas correspondientes
float out_l3a = is_visible ? (is_bull ? s_bull_l3a : s_bear_l3a) : na
float out_l3b = is_visible ? (is_bull ? s_bull_l3b : s_bear_l3b) : na
float out_l2a = is_visible ? (is_bull ? s_bull_l2a : s_bear_l2a) : na
float out_l2b = is_visible ? (is_bull ? s_bull_l2b : s_bear_l2b) : na
float out_l1a = is_visible ? (is_bull ? s_bull_l1a : s_bear_l1a) : na
float out_l1b = is_visible ? (is_bull ? s_bull_l1b : s_bear_l1b) : na

float out_ct_ca = is_visible ? (is_bull ? s_bull_ct_ca : s_bear_ct_ca) : na
float out_ct_cb = is_visible ? (is_bull ? s_bull_ct_cb : s_bear_ct_cb) : na
float out_ct_ba = is_visible ? (is_bull ? s_bull_ct_ba : s_bear_ct_ba) : na
float out_ct_bb = is_visible ? (is_bull ? s_bull_ct_bb : s_bear_ct_bb) : na
float out_ct_aa = is_visible ? (is_bull ? s_bull_ct_aa : s_bear_ct_aa) : na
float out_ct_ab = is_visible ? (is_bull ? s_bull_ct_ab : s_bear_ct_ab) : na
float out_ct_e1a = is_visible ? (is_bull ? s_bull_ct_e1a : s_bear_ct_e1a) : na
float out_ct_e1b = is_visible ? (is_bull ? s_bull_ct_e1b : s_bear_ct_e1b) : na
float out_ct_e2a = is_visible ? (is_bull ? s_bull_ct_e2a : s_bear_ct_e2a) : na
float out_ct_e2b = is_visible ? (is_bull ? s_bull_ct_e2b : s_bear_ct_e2b) : na

// =============================================================================
// 6. RENDERIZADO VISUAL Y PLOTS
// =============================================================================
// Colores de PoiSzn Lite
color col_l3 = color.new(#2962FF, 20) // Azul fuerte
color col_l2 = color.new(#00BCD4, 30) // Cyan
color col_l1 = color.new(#FF9800, 30) // Naranja

// Plots Lite v1.2
p_l3a = plot(show_lite ? out_l3a : na, "Lite Lane 3 A", color=col_l3, linewidth=1)
p_l3b = plot(show_lite ? out_l3b : na, "Lite Lane 3 B", color=col_l3, linewidth=1)
fill(p_l3a, p_l3b, color=color.new(col_l3, 80), title="Lite Lane 3 Fill")

p_l2a = plot(show_lite ? out_l2a : na, "Lite Lane 2 A", color=col_l2, linewidth=1)
p_l2b = plot(show_lite ? out_l2b : na, "Lite Lane 2 B", color=col_l2, linewidth=1)
fill(p_l2a, p_l2b, color=color.new(col_l2, 85), title="Lite Lane 2 Fill")

p_l1a = plot(show_lite ? out_l1a : na, "Lite Lane 1 A", color=col_l1, linewidth=1)
p_l1b = plot(show_lite ? out_l1b : na, "Lite Lane 1 B", color=col_l1, linewidth=1)
fill(p_l1a, p_l1b, color=color.new(col_l1, 85), title="Lite Lane 1 Fill")

// Plots Character Tree v6.5 (Opcionales)
color col_ct_c = color.new(color.fuchsia, 30)
color col_ct_b = color.new(color.yellow, 30)
color col_ct_a = color.new(color.aqua, 30)
color col_ct_e1 = color.new(color.white, 20)
color col_ct_e2 = color.new(color.gray, 20)

p_ct_ca = plot(show_ct ? out_ct_ca : na, "CT Layer C", color=col_ct_c)
p_ct_cb = plot(show_ct ? out_ct_cb : na, "CT Layer C bnd", color=col_ct_c)
fill(p_ct_ca, p_ct_cb, color=color.new(col_ct_c, 85))

p_ct_ba = plot(show_ct ? out_ct_ba : na, "CT Layer B", color=col_ct_b)
p_ct_bb = plot(show_ct ? out_ct_bb : na, "CT Layer B bnd", color=col_ct_b)
fill(p_ct_ba, p_ct_bb, color=color.new(col_ct_b, 85))

p_ct_aa = plot(show_ct ? out_ct_aa : na, "CT Layer A", color=col_ct_a)
p_ct_ab = plot(show_ct ? out_ct_ab : na, "CT Layer A bnd", color=col_ct_a)
fill(p_ct_aa, p_ct_ab, color=color.new(col_ct_a, 85))

plot(show_ct ? out_ct_e1a : na, "CT Extra 1", color=col_ct_e1)
plot(show_ct ? out_ct_e1b : na, "CT Extra 1 bnd", color=col_ct_e1)
plot(show_ct ? out_ct_e2a : na, "CT Extra 2", color=col_ct_e2)
plot(show_ct ? out_ct_e2b : na, "CT Extra 2 bnd", color=col_ct_e2)

// =============================================================================
// 7. TABLA DE DIAGNOSTICO Y AUDITORIA CIENTIFICA
// =============================================================================
var table info = table.new(position.top_right, 4, 8, bgcolor=color.new(color.black, 20), border_color=color.gray, border_width=1)
if barstate.islast
    table.cell(info, 0, 0, "Parametro", bgcolor=color.navy, text_color=color.white)
    table.cell(info, 1, 0, "Valor", bgcolor=color.navy, text_color=color.white)
    table.cell(info, 2, 0, "Capa", bgcolor=color.navy, text_color=color.white)
    table.cell(info, 3, 0, "Periodo (N)", bgcolor=color.navy, text_color=color.white)

    table.cell(info, 0, 1, "Modo de C", text_color=color.yellow)
    table.cell(info, 1, 1, c_mode, text_color=color.yellow)
    table.cell(info, 2, 1, "Lite Lane 3", text_color=color.white)
    table.cell(info, 3, 1, str.tostring(len_lite_l3a, "#.##") + " / " + str.tostring(len_lite_l3b, "#.##"), text_color=color.white)

    table.cell(info, 0, 2, "C Activo", text_color=color.green)
    table.cell(info, 1, 2, str.tostring(c_effective, "#.####") + " s", text_color=color.green)
    table.cell(info, 2, 2, "Lite Lane 2", text_color=color.white)
    table.cell(info, 3, 2, str.tostring(len_lite_l2a, "#.##") + " / " + str.tostring(len_lite_l2b, "#.##"), text_color=color.white)

    table.cell(info, 0, 3, "Resolucion (dt)", text_color=color.white)
    table.cell(info, 1, 3, str.tostring(dt) + " s", text_color=color.white)
    table.cell(info, 2, 3, "Lite Lane 1", text_color=color.white)
    table.cell(info, 3, 3, str.tostring(len_lite_l1a, "#.##") + " / " + str.tostring(len_lite_l1b, "#.##"), text_color=color.white)

    table.cell(info, 0, 4, "Velas en Rango (n)", text_color=color.white)
    table.cell(info, 1, 4, str.tostring(bar_cnt), text_color=color.white)
    table.cell(info, 2, 4, "CT Layer A", text_color=color.white)
    table.cell(info, 3, 4, str.tostring(ct_layer_a_fast) + " / " + str.tostring(ct_layer_a_slow), text_color=color.white)

    table.cell(info, 0, 5, "Rango [H - L]", text_color=color.white)
    float r_pts = rng_high - rng_low
    table.cell(info, 1, 5, str.tostring(r_pts, "#.##") + " pts (" + str.tostring(math.round(r_pts/syminfo.mintick)) + " tks)", text_color=color.white)
    table.cell(info, 2, 5, "CT Extra 1", text_color=color.white)
    table.cell(info, 3, 5, str.tostring(ct_extra1_fast) + " / " + str.tostring(ct_extra1_slow), text_color=color.white)

    table.cell(info, 0, 6, "Estado Ruptura", text_color=color.white)
    string st_str = na(breakout_side) ? "Esperando ruptura..." : (is_bull ? "Alcista (High roto)" : "Bajista (Low roto)")
    color  st_col = na(breakout_side) ? color.gray : (is_bull ? color.green : color.red)
    table.cell(info, 1, 6, st_str, text_color=st_col)
    table.cell(info, 2, 6, "CT Extra 2", text_color=color.white)
    table.cell(info, 3, 6, str.tostring(ct_extra2_fast) + " / " + str.tostring(ct_extra2_slow), text_color=color.white)

    table.cell(info, 0, 7, "Semilla Usada", text_color=color.white)
    string seed_str = na(breakout_side) ? "Pendiente" : (is_bull ? "Low END: " + str.tostring(end_low, "#.##") : "High END: " + str.tostring(end_high, "#.##"))
    table.cell(info, 1, 7, seed_str, text_color=color.white)
    table.cell(info, 2, 7, "C Auto Formula", text_color=color.aqua)
    table.cell(info, 3, 7, str.tostring(c_auto, "#.##") + " s", text_color=color.aqua)
