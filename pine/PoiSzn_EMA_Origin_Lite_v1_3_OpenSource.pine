//@version=6
indicator("PoiSzn EMA Origin Lite v1.3 (Open Source)", "PoiSzn Lite v1.3", overlay=true, max_lines_count=500, max_labels_count=500, max_boxes_count=100)

// ============================================================================
// POISZN EMA ORIGIN LITE v1.3 - OPEN SOURCE ENGINE
// Reconstrucción determinista basada en el operador matemático universal de C
// Autores: FrankyProfit & Antigravity (Auditoría Adversaria NQ1! Octubre 2026)
// ============================================================================

// ============================================================================
// 1. CONFIGURACIÓN DE ENTRADAS (INPUTS)
// ============================================================================
grp_anchors = "1. Anclas de Rango (START / END)"
start_time  = input.time(timestamp("2026-10-12 19:03:00"), "Fecha/Hora START (UTC)", group=grp_anchors)
end_time    = input.time(timestamp("2026-10-12 19:33:00"), "Fecha/Hora END (UTC)", group=grp_anchors)
source_res  = input.string("15S", "Resolución de Fuente Interna", options=["15S", "1m", "2m", "3m", "5m", "Chart"], group=grp_anchors)

grp_model   = "2. Operador Matemático de C"
mode_C      = input.string("Auto (Universal: Corto n<21 / Selector Estructural n>=21)", "Modo de Selección de C",
              options=["Auto (Universal: Corto n<21 / Selector Estructural n>=21)",
                       "Base Macroscópica: round(T / 18.3)",
                       "Régimen Corto Puro: max(dt, n*dt*10/183)",
                       "Celosía Armónica: Base + k*3s",
                       "Manual C (Calibración Directa)"], group=grp_model)
harmonic_k  = input.int(0, "Paso Armónico k en unidades de 3s (Manual Override, 0 = Automático)", minval=-25, maxval=25, group=grp_model)
manual_C    = input.float(87.0, "C Manual (segundos)", minval=1.0, step=1.0, group=grp_model)
draw_mode   = input.string("Inmediato desde END (Character Tree)", "Modo de Dibujo de Nubes", options=["Inmediato desde END (Character Tree)", "Esperar Ruptura de Caja (PoiSzn Lite)"], group=grp_model)
setup_dir   = input.string("Auto", "Dirección del Setup (Modo Inmediato)", options=["Auto", "Bullish", "Bearish"], group=grp_model)

grp_visual  = "3. Visualización y Gráfico"
show_box    = input.bool(true, "Dibujar Caja de Rango y Semilla", group=grp_visual)
show_clouds = input.bool(true, "Rellenar Nubes de Tendencia (Lanes)", group=grp_visual)
show_extra_clouds = input.bool(false, "Mostrar Nubes Extra 1 y 2 (Character Tree Completo)", group=grp_visual)
show_hud    = input.bool(true, "Mostrar Panel HUD de Telemetría", group=grp_visual)
hud_pos_str = input.string("Abajo Derecha", "Posición HUD", options=["Arriba Derecha", "Abajo Derecha", "Arriba Izquierda", "Abajo Izquierda"], group=grp_visual)

// ============================================================================
// 2. DETECCIÓN TEMPORAL Y FUENTE DE DATOS
// ============================================================================
dt_chart = timeframe.in_seconds()
float dt_fuente = dt_chart
if source_res == "15S"
    dt_fuente := 15.0
else if source_res == "1m"
    dt_fuente := 60.0
else if source_res == "2m"
    dt_fuente := 120.0
else if source_res == "3m"
    dt_fuente := 180.0
else if source_res == "5m"
    dt_fuente := 300.0
else
    dt_fuente := float(dt_chart)

// Identificación unívoca de barras en la ventana
bool is_in_range  = time >= start_time and time <= end_time
bool is_start_bar = time >= start_time and (time[1] < start_time or na(time[1]))
bool is_end_bar   = (time <= end_time) and (time + int(dt_chart * 1000) > end_time)

// Contadores de barras y extremos del rango (Independiente de Volumen)
var int   n_bars            = 0
var float start_candle_open = na
var float range_high        = na
var float range_low         = na
var int   range_high_idx    = na
var int   range_low_idx     = na
var float end_candle_high   = na
var float end_candle_low    = na
var float end_candle_open   = na
var float end_candle_close  = na
var int   end_bar_index     = na

if time < start_time
    n_bars            := 0
    start_candle_open := na
    range_high        := na
    range_low         := na
    range_high_idx    := na
    range_low_idx     := na
    end_bar_index     := na
else if is_in_range
    if is_start_bar
        n_bars            := 1
        start_candle_open := open
        range_high        := high
        range_low         := low
        range_high_idx    := bar_index
        range_low_idx     := bar_index
    else
        n_bars += 1
        if high >= range_high or na(range_high)
            range_high     := high
            range_high_idx := bar_index
        if low <= range_low or na(range_low)
            range_low     := low
            range_low_idx := bar_index

if is_end_bar
    end_bar_index    := bar_index
    end_candle_high  := high
    end_candle_low   := low
    end_candle_open  := open
    end_candle_close := close
    end_candle_vol   := nz(volume, 0.0)

bool is_post_end = not na(end_bar_index) and (bar_index > end_bar_index)
// Duración temporal T del rango en segundos y conteo inclusivo en resolución fuente
float duration_T_elapsed   = math.max(0.0, float(end_time - start_time) / 1000.0)
int   n_source_inclusive   = int(math.floor(duration_T_elapsed / dt_fuente)) + 1
float duration_T_inclusive = float(n_source_inclusive) * dt_fuente
int   n_chart_bars         = n_bars

// Sub-barras para muestreo intraminuto (llamada a nivel global obligatoria en Pine v5)
sub_closes = request.security_lower_tf(syminfo.tickerid, "15S", close)

// ============================================================================
// 3. OPERADOR MATEMÁTICO DE C Y SELECTOR ESTRUCTURAL DE CUENCA
// ============================================================================
var float C = na
var string branch_name = "Inactivo"
var string basin_event = "Ninguno"

// Cálculo de métricas de la vela END y geometría de la caja
float tot_range = math.max(syminfo.mintick, nz(range_high - range_low, syminfo.mintick))
float close_pos = nz(end_candle_close - range_low, 0.0) / tot_range
float end_candle_rng = math.max(syminfo.mintick, nz(end_candle_high - end_candle_low, syminfo.mintick))
float end_body = math.abs(nz(end_candle_close, close) - nz(end_candle_open, open))
float end_body_ratio = end_body / end_candle_rng
float upper_wick = nz(end_candle_high, high) - math.max(nz(end_candle_open, open), nz(end_candle_close, close))
float lower_wick = math.min(nz(end_candle_open, open), nz(end_candle_close, close)) - nz(end_candle_low, low)
float upper_wick_ratio = upper_wick / end_candle_rng
float lower_wick_ratio = lower_wick / end_candle_rng

// Distancias del extremo al ancla END (Independiente de volumen)
int k_H = not na(end_bar_index) and not na(range_high_idx) ? (end_bar_index - range_high_idx) : 0
int k_L = not na(end_bar_index) and not na(range_low_idx) ? (end_bar_index - range_low_idx) : 0
int h_idx = not na(range_high_idx) and not na(end_bar_index) ? ((n_bars - 1) - k_H) : 0

// Cálculo del Operador según el Régimen
if mode_C == "Auto (Universal: Corto n<21 / Selector Estructural n>=21)"
    // 1. Régimen Corto Continuo (n_inclusivo < 21 barras): Ley Analítica Exacta Universal
    if n_source_inclusive < 21
        C := math.max(dt_fuente, (duration_T_inclusive * 10.0) / 183.0)
        branch_name := "Corto_Continuo (n=" + str.tostring(n_source_inclusive) + "<21, Exacto)"
        basin_event := "Fase Continua"
    else
        // 2. Régimen Largo Discreto (n_inclusivo >= 21 barras): Motor Físico Generativo de Capping
        // Anclaje macroscópico temporal universal sobre duración transcurrida T = (n - 1) * dt (18.3 s/s)
        float C_base = math.max(dt_fuente, float(math.round((duration_T_elapsed * 10.0) / 183.0)))
        float C_val = C_base
        
        // Polaridad y origen del impulso según tooltip de TCMTrader1:
        // "Auto reads where END sits in the box (upper half = bearish, lower half = bullish)"
        bool is_bearish = nz(end_candle_close, close) >= ((nz(range_high, high) + nz(range_low, low)) / 2.0)
        float seed_price = is_bearish ? nz(range_high, high) : nz(range_low, low)
        float wick_price = is_bearish ? nz(end_candle_high, high) : nz(end_candle_low, low)
        int leg_len = is_bearish ? k_H : k_L
        int eff_bars = math.max(1, n_source_inclusive - leg_len)
        
        // Búsqueda en la celosía armónica discreta de lookbacks enteros de Nube Media u1 (N_mid = round(C * 8 / dt))
        // "Auto tries the middle cloud first and uses the slow cloud when no range carries the middle-cloud Character"
        float best_c = C_base
        float min_dist_mid = 100000.0
        bool found_mid = false
        
        int u1_base = math.max(3, math.round(C_base * 8.0 / dt_fuente))
        int u0_base = math.max(1, math.round(float(u1_base) / 3.0))
        
        // 1. Evaluación de Nube Media (b0 = 8.0)
        for k_step = -10 to 12
            int cand_u1 = u1_base + k_step
            if cand_u1 >= 3
                float alpha_mid = 2.0 / (float(cand_u1) + 1.0)
                float decay = math.pow(1.0 - alpha_mid, eff_bars)
                float ema_mid = seed_price + (1.0 - decay) * (nz(end_candle_close, close) - seed_price)
                float margin = is_bearish ? (ema_mid - wick_price) : (wick_price - ema_mid)
                float cand_c = math.round(float(cand_u1) * dt_fuente / 8.0)
                if margin >= -0.25 and math.abs(cand_c - C_base) < min_dist_mid
                    min_dist_mid := math.abs(cand_c - C_base)
                    best_c := cand_c
                    found_mid := true
                    
        // 2. Fallback a Nube Lenta (b0 = 24.0) si ninguna intermedia contiene el Character
        if not found_mid
            float min_dist_slow = 100000.0
            for k_step = -4 to 5
                int cand_u0 = u0_base + k_step
                if cand_u0 >= 1
                    float alpha_slow = 2.0 / (float(cand_u0) + 1.0)
                    float decay = math.pow(1.0 - alpha_slow, eff_bars)
                    float ema_slow = seed_price + (1.0 - decay) * (nz(end_candle_close, close) - seed_price)
                    float margin = is_bearish ? (ema_slow - wick_price) : (wick_price - ema_slow)
                    float cand_c = math.round(float(3 * cand_u0) * dt_fuente / 8.0)
                    if margin >= -0.25 and math.abs(cand_c - C_base) < min_dist_slow
                        min_dist_slow := math.abs(cand_c - C_base)
                        best_c := cand_c
                    
        C_val := best_c
        float delta_override = harmonic_k != 0 ? (float(harmonic_k) * 3.0) : 0.0
        C := math.round(C_val + delta_override)
        branch_name := "Largo_Generativo (C=" + str.tostring(C, "#") + "s, n=" + str.tostring(n_source_inclusive) + ")"
        basin_event := "Capping Armónico Base-3"
else if mode_C == "Base Macroscópica: round(T / 18.3)"
    C := math.max(dt_fuente, float(math.round((duration_T_inclusive * 10.0) / 183.0)))
    branch_name := "Base_Macroscópica"
    basin_event := "Base Pura"
else if mode_C == "Régimen Corto Puro: max(dt, n*dt*10/183)"
    C := math.max(dt_fuente, (duration_T_inclusive * 10.0) / 183.0)
    branch_name := "Corto_Continuo_Puro"
    basin_event := "Corto Puro"
else if mode_C == "Celosía Armónica: Base + k*3s"
    float C_base = math.max(dt_fuente, float(math.round((duration_T_inclusive * 10.0) / 183.0)))
    C := C_base + (float(harmonic_k) * 3.0)
    branch_name := "Celosía_Armónica_k3"
    basin_event := "Manual k=" + str.tostring(harmonic_k)
else if mode_C == "Manual C (Calibración Directa)"
    C := manual_C
    branch_name := "Manual_Fijo (" + str.tostring(manual_C, "#") + "s)"
    basin_event := "Manual Fijo"

// ============================================================================
// 4. FACTORES BASE Y ALPHAS DE LAS 10 CURVAS (CHARACTER TREE & POISZN LITE)
// ============================================================================
// Lookback central base (Middle Center):
// N_mid = round(C * 8 / dt)
int N_mid_c = math.max(3, math.round(C * (8.0 / dt_fuente)))
int N_mid_b = math.max(3, math.round(float(N_mid_c) * 1.25))

// Recurrencia armónica oficial en base 3 demostrada de TCMTrader1:
// Lane 1 (Slow): u0 = round(u1 / 3), v0 = round(v1 / 3)
int u0 = math.max(1, math.round(float(N_mid_c) / 3.0))
int v0 = math.max(1, math.round(float(N_mid_b) / 3.0))

// Lane 2 (Middle): u1 = 3 * u0, v1 = 3 * v0
int u1 = 3 * u0
int v1 = 3 * v0

// Lane 3 (Fast): u2 = 3 * u1 - 1, v2 = 3 * v1 - 1
int u2 = 3 * u1 - 1
int v2 = 3 * v1 - 1

// Lane 4 (Extra 1 - Character Tree): u3 = 3 * u2 + 1, v3 = 3 * v2 - 1
int u3 = 3 * u2 + 1
int v3 = 3 * v2 - 1

// Lane 5 (Extra 2 - Character Tree): u4 = 3 * u3 - 1, v4 = 3 * v3 - 1
int u4 = 3 * u3 - 1
int v4 = 3 * v3 - 1

// Factores alpha correspondientes a cada período entero N
alpha_1a = 2.0 / (float(u0) + 1.0)
alpha_1b = 2.0 / (float(v0) + 1.0)
alpha_2a = 2.0 / (float(u1) + 1.0)
alpha_2b = 2.0 / (float(v1) + 1.0)
alpha_3a = 2.0 / (float(u2) + 1.0)
alpha_3b = 2.0 / (float(v2) + 1.0)
alpha_4a = 2.0 / (float(u3) + 1.0)
alpha_4b = 2.0 / (float(v3) + 1.0)
alpha_5a = 2.0 / (float(u4) + 1.0)
alpha_5b = 2.0 / (float(v4) + 1.0)

// Períodos nominales equivalentes (N)
N_1a = u0
N_1b = v0
N_2a = u1
N_2b = v1
N_3a = u2
N_3b = v2
N_4a = u3
N_4b = v3
N_5a = u4
N_5b = v4

// ============================================================================
// 5. COMPUERTA DE RUPTURA, SEMILLA Y RECURRENCIA EMA (10 CURVAS)
// ============================================================================
var bool  has_broken_out = false
var int   breakout_dir   = 0     // +1: Alcista, -1: Bajista
var float chosen_seed    = na

// Estados recurrentes en paralelo (alcista y bajista)
var float s_bull_3a = na
var float s_bull_3b = na
var float s_bull_2a = na
var float s_bull_2b = na
var float s_bull_1a = na
var float s_bull_1b = na
var float s_bull_4a = na
var float s_bull_4b = na
var float s_bull_5a = na
var float s_bull_5b = na

var float s_bear_3a = na
var float s_bear_3b = na
var float s_bear_2a = na
var float s_bear_2b = na
var float s_bear_1a = na
var float s_bear_1b = na
var float s_bear_4a = na
var float s_bear_4b = na
var float s_bear_5a = na
var float s_bear_5b = na

// Inicialización de Semilla en la barra de END
if is_end_bar
    // Determinar dirección del setup
    bool is_bearish_setup = false
    if setup_dir == "Bearish"
        is_bearish_setup := true
    else if setup_dir == "Bullish"
        is_bearish_setup := false
    else // "Auto" (TCMTrader1 Character Tree: upper half = bearish, lower half = bullish)
        is_bearish_setup := nz(end_candle_close, close) >= ((nz(range_high, high) + nz(range_low, low)) / 2.0)

    if draw_mode == "Inmediato desde END (Character Tree)"
        has_broken_out := true
        breakout_dir   := is_bearish_setup ? -1 : 1
        chosen_seed    := is_bearish_setup ? end_candle_high : end_candle_low
    else
        has_broken_out := false
        breakout_dir   := 0
        chosen_seed    := na
    
    // Alcista: Semilla = Low de END
    s_bull_3a := end_candle_low
    s_bull_3b := end_candle_low
    s_bull_2a := end_candle_low
    s_bull_2b := end_candle_low
    s_bull_1a := end_candle_low
    s_bull_1b := end_candle_low
    s_bull_4a := end_candle_low
    s_bull_4b := end_candle_low
    s_bull_5a := end_candle_low
    s_bull_5b := end_candle_low

    // Bajista: Semilla = High de END
    s_bear_3a := end_candle_high
    s_bear_3b := end_candle_high
    s_bear_2a := end_candle_high
    s_bear_2b := end_candle_high
    s_bear_1a := end_candle_high
    s_bear_1b := end_candle_high
    s_bear_4a := end_candle_high
    s_bear_4b := end_candle_high
    s_bear_5a := end_candle_high
    s_bear_5b := end_candle_high

// Actualización recurrente barra a barra tras END
if is_post_end
    bool has_subbars = (source_res == "15S") and (dt_chart > 15) and (array.size(sub_closes) > 0)

    if has_subbars
        for i = 0 to array.size(sub_closes) - 1
            float sc = array.get(sub_closes, i)
            s_bull_3a := s_bull_3a + alpha_3a * (sc - s_bull_3a)
            s_bull_3b := s_bull_3b + alpha_3b * (sc - s_bull_3b)
            s_bull_2a := s_bull_2a + alpha_2a * (sc - s_bull_2a)
            s_bull_2b := s_bull_2b + alpha_2b * (sc - s_bull_2b)
            s_bull_1a := s_bull_1a + alpha_1a * (sc - s_bull_1a)
            s_bull_1b := s_bull_1b + alpha_1b * (sc - s_bull_1b)
            s_bull_4a := s_bull_4a + alpha_4a * (sc - s_bull_4a)
            s_bull_4b := s_bull_4b + alpha_4b * (sc - s_bull_4b)
            s_bull_5a := s_bull_5a + alpha_5a * (sc - s_bull_5a)
            s_bull_5b := s_bull_5b + alpha_5b * (sc - s_bull_5b)

            s_bear_3a := s_bear_3a + alpha_3a * (sc - s_bear_3a)
            s_bear_3b := s_bear_3b + alpha_3b * (sc - s_bear_3b)
            s_bear_2a := s_bear_2a + alpha_2a * (sc - s_bear_2a)
            s_bear_2b := s_bear_2b + alpha_2b * (sc - s_bear_2b)
            s_bear_1a := s_bear_1a + alpha_1a * (sc - s_bear_1a)
            s_bear_1b := s_bear_1b + alpha_1b * (sc - s_bear_1b)
            s_bear_4a := s_bear_4a + alpha_4a * (sc - s_bear_4a)
            s_bear_4b := s_bear_4b + alpha_4b * (sc - s_bear_4b)
            s_bear_5a := s_bear_5a + alpha_5a * (sc - s_bear_5a)
            s_bear_5b := s_bear_5b + alpha_5b * (sc - s_bear_5b)
    else
        // Actualización estándar contra el cierre de la barra actual
        s_bull_3a := s_bull_3a + alpha_3a * (close - s_bull_3a)
        s_bull_3b := s_bull_3b + alpha_3b * (close - s_bull_3b)
        s_bull_2a := s_bull_2a + alpha_2a * (close - s_bull_2a)
        s_bull_2b := s_bull_2b + alpha_2b * (close - s_bull_2b)
        s_bull_1a := s_bull_1a + alpha_1a * (close - s_bull_1a)
        s_bull_1b := s_bull_1b + alpha_1b * (close - s_bull_1b)
        s_bull_4a := s_bull_4a + alpha_4a * (close - s_bull_4a)
        s_bull_4b := s_bull_4b + alpha_4b * (close - s_bull_4b)
        s_bull_5a := s_bull_5a + alpha_5a * (close - s_bull_5a)
        s_bull_5b := s_bull_5b + alpha_5b * (close - s_bull_5b)

        s_bear_3a := s_bear_3a + alpha_3a * (close - s_bear_3a)
        s_bear_3b := s_bear_3b + alpha_3b * (close - s_bear_3b)
        s_bear_2a := s_bear_2a + alpha_2a * (close - s_bear_2a)
        s_bear_2b := s_bear_2b + alpha_2b * (close - s_bear_2b)
        s_bear_1a := s_bear_1a + alpha_1a * (close - s_bear_1a)
        s_bear_1b := s_bear_1b + alpha_1b * (close - s_bear_1b)
        s_bear_4a := s_bear_4a + alpha_4a * (close - s_bear_4a)
        s_bear_4b := s_bear_4b + alpha_4b * (close - s_bear_4b)
        s_bear_5a := s_bear_5a + alpha_5a * (close - s_bear_5a)
        s_bear_5b := s_bear_5b + alpha_5b * (close - s_bear_5b)

    // Detección de Ruptura de Rango (Compuerta Booleana para modo PoiSzn Lite)
    if not has_broken_out and (draw_mode == "Esperar Ruptura de Caja (PoiSzn Lite)")
        if close > range_high
            has_broken_out := true
            breakout_dir   := 1
            chosen_seed    := end_candle_low
        else if close < range_low
            has_broken_out := true
            breakout_dir   := -1
            chosen_seed    := end_candle_high

// ============================================================================
// 6. ASIGNACIÓN Y RENDERIZADO DE CURVAS ACTIVAS (10 CURVAS)
// ============================================================================
float lane_3a = na
float lane_3b = na
float lane_2a = na
float lane_2b = na
float lane_1a = na
float lane_1b = na
float lane_4a = na
float lane_4b = na
float lane_5a = na
float lane_5b = na

if is_post_end and has_broken_out
    if breakout_dir == 1
        lane_3a := s_bull_3a
        lane_3b := s_bull_3b
        lane_2a := s_bull_2a
        lane_2b := s_bull_2b
        lane_1a := s_bull_1a
        lane_1b := s_bull_1b
        lane_4a := s_bull_4a
        lane_4b := s_bull_4b
        lane_5a := s_bull_5a
        lane_5b := s_bull_5b
    else if breakout_dir == -1
        lane_3a := s_bear_3a
        lane_3b := s_bear_3b
        lane_2a := s_bear_2a
        lane_2b := s_bear_2b
        lane_1a := s_bear_1a
        lane_1b := s_bear_1b
        lane_4a := s_bear_4a
        lane_4b := s_bear_4b
        lane_5a := s_bear_5a
        lane_5b := s_bear_5b

// Paleta Oficial de PoiSzn EMA Origin Lite & Character Tree
c_lane3 = color.new(#00e5ff, 15)  // Cyan oficial (Lane 3 Fast)
c_lane2 = color.new(#2979ff, 15)  // Azul oficial (Lane 2 Mid)
c_lane1 = color.new(#d500f9, 15)  // Magenta / Púrpura oficial (Lane 1 Slow)
c_lane4 = color.new(#4caf50, 15)  // Verde oficial (Lane 4 Extra 1 - Character Tree)
c_lane5 = color.new(#ff9800, 15)  // Naranja oficial (Lane 5 Extra 2 - Character Tree)

// Trazado de las 6 líneas base
p_3a = plot(lane_3a, "Lane 3 A (Fast Center)", color=c_lane3, linewidth=2)
p_3b = plot(lane_3b, "Lane 3 B (Fast Boundary)", color=c_lane3, linewidth=1)
p_2a = plot(lane_2a, "Lane 2 A (Mid Center)", color=c_lane2, linewidth=2)
p_2b = plot(lane_2b, "Lane 2 B (Mid Boundary)", color=c_lane2, linewidth=1)
p_1a = plot(lane_1a, "Lane 1 A (Slow Center)", color=c_lane1, linewidth=2)
p_1b = plot(lane_1b, "Lane 1 B (Slow Boundary)", color=c_lane1, linewidth=1)

// Trazado de las 4 líneas extra de Character Tree (Lanes 4 y 5)
p_4a = plot(show_extra_clouds ? lane_4a : na, "Lane 4 A (Extra 1 Center)", color=c_lane4, linewidth=2)
p_4b = plot(show_extra_clouds ? lane_4b : na, "Lane 4 B (Extra 1 Boundary)", color=c_lane4, linewidth=1)
p_5a = plot(show_extra_clouds ? lane_5a : na, "Lane 5 A (Extra 2 Center)", color=c_lane5, linewidth=2)
p_5b = plot(show_extra_clouds ? lane_5b : na, "Lane 5 B (Extra 2 Boundary)", color=c_lane5, linewidth=1)

// Relleno de nubes (colores condicionales en ámbito global)
color c_fill_3 = show_clouds ? color.new(#00e5ff, 82) : na
color c_fill_2 = show_clouds ? color.new(#2979ff, 82) : na
color c_fill_1 = show_clouds ? color.new(#d500f9, 82) : na
color c_fill_4 = (show_clouds and show_extra_clouds) ? color.new(#4caf50, 82) : na
color c_fill_5 = (show_clouds and show_extra_clouds) ? color.new(#ff9800, 82) : na

fill(p_3a, p_3b, color=c_fill_3, title="Nube Lane 3 (Fast)")
fill(p_2a, p_2b, color=c_fill_2, title="Nube Lane 2 (Mid)")
fill(p_1a, p_1b, color=c_fill_1, title="Nube Lane 1 (Slow)")
fill(p_4a, p_4b, color=c_fill_4, title="Nube Lane 4 (Extra 1)")
fill(p_5a, p_5b, color=c_fill_5, title="Nube Lane 5 (Extra 2)")

// ============================================================================
// 7. CAJA DE RANGO Y ANCLAS VISUALES
// ============================================================================
var box range_box = na
if show_box and is_end_bar and not na(range_high) and not na(range_low)
    box.delete(range_box)
    range_box := box.new(left=start_time, top=range_high, right=end_time, bottom=range_low,
                         xloc=xloc.bar_time, border_color=color.gray, border_style=line.style_dashed,
                         bgcolor=color.new(color.blue, 92))

// ============================================================================
// 8. PANEL DE TELEMETRÍA (HUD)
// ============================================================================
var table hud = na
if show_hud and barstate.islast
    string table_pos = position.bottom_right
    if hud_pos_str == "Arriba Derecha"
        table_pos := position.top_right
    else if hud_pos_str == "Abajo Derecha"
        table_pos := position.bottom_right
    else if hud_pos_str == "Arriba Izquierda"
        table_pos := position.top_left
    else if hud_pos_str == "Abajo Izquierda"
        table_pos := position.bottom_left

    hud := table.new(table_pos, 2, 11, bgcolor=color.new(#131722, 10), border_color=color.gray, border_width=1)
    
    string header_title = (draw_mode == "Inmediato desde END (Character Tree)") ? "CHARACTER TREE v6.5" : "POISZN LITE v1.3"
    table.cell(hud, 0, 0, header_title, bgcolor=color.new(#2979ff, 20), text_color=color.white, text_size=size.small)
    table.cell(hud, 1, 0, "TELEMETRÍA", bgcolor=color.new(#2979ff, 20), text_color=color.white, text_size=size.small)

    table.cell(hud, 0, 1, "C (segundos)", text_color=color.white, text_size=size.small)
    string c_display = (n_source_inclusive < 21) ? str.tostring(C, "#.####") : str.tostring(C, "#")
    table.cell(hud, 1, 1, c_display + " s", text_color=color.yellow, text_size=size.small)

    table.cell(hud, 0, 2, "Rama Operador", text_color=color.white, text_size=size.small)
    table.cell(hud, 1, 2, branch_name, text_color=color.aqua, text_size=size.small)

    table.cell(hud, 0, 3, "Duración T (seg)", text_color=color.white, text_size=size.small)
    table.cell(hud, 1, 3, str.tostring(duration_T_inclusive, "#") + " s (" + str.tostring(n_source_inclusive) + " barras fuente / " + str.tostring(n_chart_bars) + " barras gráfico)", text_color=color.white, text_size=size.small)

    table.cell(hud, 0, 4, "Resolución Fuente", text_color=color.white, text_size=size.small)
    table.cell(hud, 1, 4, source_res + " (dt=" + str.tostring(dt_fuente, "#") + "s)", text_color=color.white, text_size=size.small)

    table.cell(hud, 0, 5, "Semilla END", text_color=color.white, text_size=size.small)
    table.cell(hud, 1, 5, na(chosen_seed) ? "Esperando Ruptura" : str.tostring(chosen_seed, "#.2f"), text_color=color.white, text_size=size.small)

    table.cell(hud, 0, 6, "Modo / Compuerta", text_color=color.white, text_size=size.small)
    string st_break = (draw_mode == "Inmediato desde END (Character Tree)") ? 
         ("INMEDIATO (" + (breakout_dir == 1 ? "Alcista" : "Bajista") + ")") : 
         (has_broken_out ? (breakout_dir == 1 ? "ACTIVA (Alcista)" : "ACTIVA (Bajista)") : "INACTIVA (Sin Ruptura)")
    color col_break = has_broken_out ? color.green : color.orange
    table.cell(hud, 1, 6, st_break, text_color=col_break, text_size=size.small)

    table.cell(hud, 0, 7, "Períodos N Base", text_color=color.white, text_size=size.small)
    table.cell(hud, 1, 7, "Slow: " + str.tostring(N_1a) + "/" + str.tostring(N_1b) + " | Mid: " + str.tostring(N_2a) + "/" + str.tostring(N_2b) + " | Fast: " + str.tostring(N_3a) + "/" + str.tostring(N_3b), text_color=color.white, text_size=size.small)

    table.cell(hud, 0, 8, "Períodos N Extra (CT)", text_color=color.white, text_size=size.small)
    table.cell(hud, 1, 8, "Ex1: " + str.tostring(N_4a) + "/" + str.tostring(N_4b) + " | Ex2: " + str.tostring(N_5a) + "/" + str.tostring(N_5b), text_color=color.white, text_size=size.small)

    table.cell(hud, 0, 9, "Lectura Slow / Fast", text_color=color.white, text_size=size.small)
    string txt_lanes = na(lane_1a) ? "∅" : (str.tostring(lane_1a, "#.2f") + " | " + str.tostring(lane_3a, "#.2f"))
    table.cell(hud, 1, 9, txt_lanes, text_color=color.white, text_size=size.small)

    table.cell(hud, 0, 10, "Cuenca Estructural", text_color=color.white, text_size=size.small)
    table.cell(hud, 1, 10, basin_event, text_color=color.orange, text_size=size.small)

